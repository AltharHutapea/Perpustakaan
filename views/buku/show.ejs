<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Buku</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 40px 20px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border-radius: 32px;
            padding: 40px;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.3);
        }
        .back-link {
            display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px;
            color: #667eea; text-decoration: none; font-weight: 500;
        }
        .detail-card {
            background: linear-gradient(145deg, #fff, #f8fafc);
            border-radius: 28px;
            padding: 30px;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
        }
        .detail-item {
            display: flex;
            padding: 16px 0;
            border-bottom: 1px solid #eef2ff;
        }
        .detail-label {
            width: 140px;
            font-weight: 700;
            color: #475569;
        }
        .detail-value {
            flex: 1;
            color: #1e293b;
            font-weight: 500;
        }
        .badge {
            background: #e0e7ff;
            color: #4f46e5;
            padding: 4px 12px;
            border-radius: 40px;
            font-size: 12px;
            font-weight: 600;
        }
        footer {
            margin-top: 32px;
            text-align: center;
            font-size: 14px;
            color: #94a3b8;
        }
    </style>
</head>
<body>
<div class="container">
    <a href="/buku" class="back-link"><i class="fas fa-arrow-left"></i> Kembali ke Daftar Buku</a>
    <div class="detail-card">
        <div class="detail-item">
            <div class="detail-label">ID Buku</div>
            <div class="detail-value"><span class="badge">#<%= buku.id_buku %></span></div>
        </div>
        <div class="detail-item">
            <div class="detail-label">Judul</div>
            <div class="detail-value"><strong><%= buku.judul %></strong></div>
        </div>
        <div class="detail-item">
            <div class="detail-label">Pengarang</div>
            <div class="detail-value"><%= buku.pengarang || '-' %></div>
        </div>
        <div class="detail-item">
            <div class="detail-label">Penerbit</div>
            <div class="detail-value"><%= buku.penerbit || '-' %></div>
        </div>
        <div class="detail-item">
            <div class="detail-label">Tahun Terbit</div>
            <div class="detail-value"><%= buku.tahun_terbit || '-' %></div>
        </div>
        <div class="detail-item">
            <div class="detail-label">Perpustakaan</div>
            <div class="detail-value">
                <i class="fas fa-building"></i> <%= buku.nama_perpus %>
                <span style="font-size:12px; color:#64748b;">(ID: <%= buku.id_perpus %>)</span>
            </div>
        </div>
    </div>
    <footer><i class="fas fa-info-circle"></i> Informasi buku dari sistem perpustakaan digital</footer>
</div>
</body>
</html>